# Security Intelligence Monitor - Configuration
# Copy this file to .env and adjust values as needed.

# NVD API Configuration (Free key optional, provides higher rate limits)
# Request key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GitHub Token (Optional, increases rate limit from 60 to 5,000 req/hr)
# Create token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# Notification Settings
# Options: IMMEDIATE_CRITICAL_KEV, ALL_IMMEDIATE, DISABLED
EMAIL_NOTIFICATION_POLICY=IMMEDIATE_CRITICAL_KEV

# Scheduling Settings
CHECK_INTERVAL_MINUTES=60
APP_TIMEZONE=UTC

# Database & Storage
DATABASE_URL=sqlite:///data/security_monitor.db
LOG_LEVEL=INFO

# First-Run Baseline Mode (true = import records without sending alert flood)
BASELINE_MODE=true
